# Copy to env.sh (gitignored) and fill in. Every variable keeps a value already set in the
# environment, so `VAR=... bash beacon3d/<script>.sh` overrides it.

# --- caches / scratch ---
export LEO_ROOT="${LEO_ROOT:-/path/to/storage/leo}"       # venv, LEO weights, Vicuna, scan data
export LEO_ENV="${LEO_ENV:-$LEO_ROOT/venv}"
export HF_HOME="${HF_HOME:-/path/to/huggingface_cache}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/path/to/uv_cache}"
export TMPDIR="${TMPDIR:-/path/to/tmp}"; mkdir -p "$TMPDIR"
export LEO_CUDA_HOME="${LEO_CUDA_HOME:-/usr/local/cuda-12.9}"    # CUDA 12.x >= 12.8 (Blackwell sm_120)

# --- benchmark inputs ---
export SCENEVERSE_DIR="${SCENEVERSE_DIR:-/path/to/SceneVerse/scan_data}"  # MultiScan/ (Beacon3D MultiScan)
export LEO_ANNO="${LEO_ANNO:-$LEO_ROOT/annotations/instruction}"  # LEO_data annotations.zip: scan2cap/ scanqa/ sqa3d/
export REAL3DQA_DIR="${REAL3DQA_DIR:-/path/to/Real-3DQA}"        # <split>.jsonl from HF Oliver-Ma/Real-3DQA
# LEO_ROOT/scannet/mask/ = LEO_data mask.zip (Mask3D proposals) for extra_eval/
export JAVA_HOME="${JAVA_HOME:-/path/to/jre11}"; export PATH="$JAVA_HOME/bin:$PATH"   # METEOR in extra_eval/score.sh

# --- scoring ---
# export OPENAI_API_KEY=sk-...                                   # Beacon3D QA GPT judge
